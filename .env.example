# Copy to `.env.local` (development) or set these in your hosting panel (production).
# Never commit real values.

# Public URL of the site, used for canonical/hreflang links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.dawnwave.com.tr

# --- Gmail (contact & subscribe forms) ---------------------------------------
# Gmail account that sends the form emails.
GMAIL_USER=your.address@gmail.com
# Google App Password (not your normal password):
#   1. Turn on 2-Step Verification for the account.
#   2. Create a password at https://myaccount.google.com/apppasswords
# The 16 characters can be pasted with or without spaces.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Optional: inbox that receives the submissions. Defaults to GMAIL_USER.
CONTACT_EMAIL=

# --- Rate limiting (optional) ------------------------------------------------
# Upstash Redis REST credentials (https://console.upstash.com). When set, form rate
# limits are shared across all server instances; otherwise an in-memory limit is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
